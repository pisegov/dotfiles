# change window focus within space
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - h : yabai -m window --focus west
alt - l : yabai -m window --focus east

#change focus between external displays (left and right)
alt - m: yabai -m display --focus west
alt - 0x2F: yabai -m display --focus east

# rotate layout clockwise
alt + cmd - r : yabai -m space --rotate 270

# flip along y-axis
alt + cmd - y : yabai -m space --mirror y-axis

# flip along x-axis
alt + cmd - x : yabai -m space --mirror x-axis

# toggle window float
shift + alt - f : yabai -m window --toggle float --grid 4:4:1:1:2:2

# maximize a window
alt - f : yabai -m window --toggle zoom-fullscreen

# balance out tree of windows (resize to occupy same area)
alt + cmd - e : yabai -m space --balance

# swap windows
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - h : yabai -m window --swap west
shift + alt - l : yabai -m window --swap east

# move window and split
# ctrl + cmd - j : yabai -m window --warp south
# ctrl + cmd - k : yabai -m window --warp north
# ctrl + cmd - h : yabai -m window --warp west
# ctrl + cmd - l : yabai -m window --warp east

# move window to display left and right
shift + alt - m : yabai -m window --display west; yabai -m display --focus west;
shift + alt - 0x2F : yabai -m window --display east; yabai -m display --focus east;

#move window to prev and next space
# shift + alt - p : yabai -m window --space prev;
# shift + alt - n : yabai -m window --space next;

# move window to space #
shift + alt - q : yabai -m window --space 1;
shift + alt - w : yabai -m window --space 2;
shift + alt - e : yabai -m window --space 3;
shift + alt - r : yabai -m window --space 4;
shift + alt - t : yabai -m window --space 5;
shift + alt - y : yabai -m window --space 6;
shift + alt - u : yabai -m window --space 7;
shift + alt - i : yabai -m window --space 8;
shift + alt - o : yabai -m window --space 9;

# Resize windows
lctrl + alt - h : yabai -m window --resize left:-50:0; \
                  yabai -m window --resize right:-50:0
lctrl + alt - j : yabai -m window --resize bottom:0:50; \
                  yabai -m window --resize top:0:50
lctrl + alt - k : yabai -m window --resize top:0:-50; \
                  yabai -m window --resize bottom:0:-50
lctrl + alt - l : yabai -m window --resize right:50:0; \
                  yabai -m window --resize left:50:0

# stop/start/restart yabai
ctrl + alt - q : brew services stop yabai
ctrl + alt - s : brew services start yabai
ctrl + alt - r : brew services restart yabai

cmd + shift - q : skhd --key "cmd - q" 

# alt - return : open -a "iTerm" -n
alt - return : open -a "kitty" -n

# open Chrome.
# alt + shift - return : open -na "Emacs Client"
alt + shift - return : emacsclient -c -e  "(select-frame-set-input-focus (selected-frame))" & 
cmd - w : echo > /dev/null
