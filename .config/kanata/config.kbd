(defvar
    tt 150
    ht 100
)

(defcfg
    process-unmapped-keys yes
    macos-dev-names-include ("Apple Internal Keyboard / Trackpad")
)

(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10   f11   f12
  caps a s d f j k l ;
  fn
)

(defalias
    ;; hold timeout used for both timeout properties in purpose
    ;; because i don't need to input multiple escapes when i tap + release + tap again
  escctrl (tap-hold-press $ht $ht esc lctrl)

  d (tap-hold-release $tt $ht d lalt)
  k (tap-hold-release $tt $ht k ralt)

  s (tap-hold-release $tt $ht s lctrl)
  l (tap-hold-release $tt $ht l rctrl)

  a (tap-hold-release $tt $ht a lmet)
  ; (tap-hold-release $tt $ht ; rmet)

  f (tap-hold-release $tt $ht f lsft)
  j (tap-hold-release $tt $ht j rsft)

  fnl (tap-hold 200 200 fn (layer-toggle fn))
)

(deflayer base
    brdn brup _ _ _ _ prev pp next mute vold volu
    @escctrl @a @s @d @f  @j @k @l @;
    @fnl
)


(deflayer fn
    f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
    @escctrl _ _ _ _ _ _ _ _
    fn
)
